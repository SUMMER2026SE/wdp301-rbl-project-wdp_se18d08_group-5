# Server
PORT=4300
NODE_ENV=development

# MongoDB
MONGODB_URI=
# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Google AI Studio / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_API_KEYS=your-first-ai-judge-key,your-second-ai-judge-key
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="AI Debate Platform <your-gmail@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS
CLIENT_URL=http://localhost:5173

# Cloudflare Realtime TURN (server-side secrets; never expose through VITE_*)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=7200
